<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores may leave the device: not through cloud backup and not
  through device-to-device transfer. The Telegram session, message cache, captured
  media and settings all stay on the phone they were created on.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
